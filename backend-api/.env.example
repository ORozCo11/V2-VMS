APP_NAME=Laravel

# NOTE: APP_ENV=local, APP_DEBUG=true, and LOG_LEVEL=debug below are for
# LOCAL DEVELOPMENT ONLY. Before deploying to any real/production
# environment, change them to:
#   APP_ENV=production
#   APP_DEBUG=false
#   LOG_LEVEL=error
# Leaving APP_DEBUG=true in production leaks stack traces (including
# secrets from this file) to anyone who triggers an error.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
# Where the React app is served; account emails link to {FRONTEND_URL}/login.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# LOCAL DEVELOPMENT ONLY — use LOG_LEVEL=error (or similar) in production.
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Minutes until an issued Sanctum API token (login or impersonation) expires.
# See config/sanctum.php. 10080 = 7 days.
SANCTUM_TOKEN_EXPIRATION=10080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloud Storage — Supabase Storage (S3-compatible)
# Get these from: https://supabase.com → Project Settings → API
# Uncomment the line below to make Supabase the default disk once the
# SUPABASE_* credentials below are filled in. Left commented, FILESYSTEM_DISK
# stays "local" (set above) so the app works out-of-the-box on a fresh clone
# without needing Supabase set up first.
# FILESYSTEM_DISK=supabase
SUPABASE_KEY=your_service_role_key_here
SUPABASE_SECRET=your_service_role_key_here
SUPABASE_REGION=ap-southeast-1
SUPABASE_BUCKET=vehicle-photos
# A separate PRIVATE bucket for new uploads; never use a public bucket here.
# Leave unset to use the private local fallback. Keep SUPABASE_BUCKET/URL
# for the optional media:privatize legacy inventory/migration command.
SUPABASE_PRIVATE_BUCKET=
SUPABASE_ENDPOINT=https://your_project_id.supabase.co/storage/v1/s3
SUPABASE_URL=https://your_project_id.supabase.co/storage/v1/object/public/vehicle-photos

VITE_APP_NAME="${APP_NAME}"
