<mxfile host="app.diagrams.net">
  <!-- Ticket -->
  <diagram id="st-ticket" name="Maintenance Ticket">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="State Transition Diagram — Maintenance Ticket" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="125" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pa" value="Pending Approval" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="200" y="110" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dec" value="Declined" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="200" y="330" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act" value="Active&lt;br&gt;(under repair)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fv" value="For Verification" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="840" y="110" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cl" value="Closed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="840" y="330" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="can" value="Cancelled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="520" y="500" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="910" y="470" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="Custodian proposes ticket&lt;br&gt;(from issue report or condition check)&lt;br&gt;or System: maintenance schedule falls due" style="html=1;endArrow=block;verticalAlign=bottom;fontSize=10;" edge="1" parent="1" source="start" target="pa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Admin requests corrections /&lt;br&gt;Custodian resubmits" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="pa" target="pa">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="285" y="70" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t3" value="Admin declines" style="html=1;endArrow=block;fontSize=10;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="pa" target="dec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="Admin un-declines" style="html=1;endArrow=block;fontSize=10;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="dec" target="pa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="Admin approves and&lt;br&gt;assigns Maintenance Personnel" style="html=1;endArrow=block;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="pa" target="act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="Admin approves" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="dec" target="act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="Maintenance Personnel logs repairs&lt;br&gt;(all work items done) or submits&lt;br&gt;for verification" style="html=1;endArrow=block;fontSize=10;verticalAlign=bottom;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="act" target="fv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="Custodian rejects verification&lt;br&gt;(ticket returned for repair)" style="html=1;endArrow=block;fontSize=10;verticalAlign=top;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="fv" target="act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="Custodian verifies&lt;br&gt;(functional test passed)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="fv" target="cl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="" style="html=1;endArrow=block;" edge="1" parent="1" source="cl" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t11" value="Admin cancels" style="html=1;endArrow=block;fontSize=10;exitX=0.5;exitY=1;entryX=0;entryY=0.3;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="pa" target="can">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="150" y="140" /><mxPoint x="150" y="518" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t12" value="Admin cancels" style="html=1;endArrow=block;fontSize=10;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="act" target="can">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t13" value="Admin cancels" style="html=1;endArrow=block;fontSize=10;exitX=0.2;exitY=1;entryX=1;entryY=0.3;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="fv" target="can">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="874" y="250" /><mxPoint x="760" y="250" /><mxPoint x="760" y="518" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="t14" value="Admin un-cancels&lt;br&gt;(returns to its previous status)" style="html=1;endArrow=block;fontSize=10;dashed=1;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="can" target="act">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Closed is final; a closed ticket cannot be cancelled or reopened.&lt;br&gt;• Closing a ticket closes its linked issue report and completes its linked maintenance schedule.&lt;br&gt;• External-shop repairs stay in Active — see the &quot;External Shop Work Item&quot; page." style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;size=14;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="560" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- External shop -->
  <diagram id="st-external" name="External Shop Work Item">
    <mxGraphModel dx="1100" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="State Transition Diagram — Ticket Sent to External Shop" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p" value="Pending" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="120" y="110" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a" value="Approved&lt;br&gt;(at external shop)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t" value="Tested&lt;br&gt;(by Maintenance Personnel)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="570" y="110" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v" value="Verified&lt;br&gt;(by Custodian)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="820" y="110" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c" value="Closed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="820" y="300" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="880" y="430" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dec" value="Declined" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="120" y="300" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="Custodian proposes&lt;br&gt;external repair" style="html=1;endArrow=block;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="start" target="p">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Admin approves;&lt;br&gt;vehicle sent to shop" style="html=1;endArrow=block;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="p" target="a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Admin declines" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="p" target="dec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Vehicle returned;&lt;br&gt;Maintenance Personnel&lt;br&gt;tests the repair" style="html=1;endArrow=block;fontSize=10;verticalAlign=bottom;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="a" target="t">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="Test failed:&lt;br&gt;sent back to shop" style="html=1;endArrow=block;fontSize=10;verticalAlign=top;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="t" target="a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="Test passed" style="html=1;endArrow=block;fontSize=10;verticalAlign=bottom;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="t" target="v">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Custodian rejects" style="html=1;endArrow=block;fontSize=10;verticalAlign=top;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="v" target="t">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Custodian verifies" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="v" target="c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="" style="html=1;endArrow=block;" edge="1" parent="1" source="c" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Target flow (panel feedback):&lt;/b&gt; Pending → Approved → Tested by Maintenance Personnel → Verified by Custodian → Closed.&lt;br&gt;&lt;b&gt;Current code:&lt;/b&gt; the ticket stays Active while the work item moves Awaiting dispatch → At external shop → Returned, and the Admin (not Maintenance Personnel) records the repair. Plan task T26 changes this to match." style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;size=14;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="700" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- Vehicle -->
  <diagram id="st-vehicle" name="Vehicle Status">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="State Transition Diagram — Vehicle Status" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="av" value="Available" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="170" y="120" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="um" value="Under Maintenance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="in" value="Inactive&lt;br&gt;(archived)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="170" y="380" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dc" value="Decommissioned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="620" y="380" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="v1" value="Admin registers vehicle" style="html=1;endArrow=block;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="start" target="av">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Condition check finds &quot;Needs Repair&quot;&lt;br&gt;or a repair ticket is approved" style="html=1;endArrow=block;fontSize=10;verticalAlign=bottom;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="av" target="um">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="Ticket closed, readiness check passed;&lt;br&gt;Admin/Custodian marks available" style="html=1;endArrow=block;fontSize=10;verticalAlign=top;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="um" target="av">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="Admin archives&lt;br&gt;(no open tickets)" style="html=1;endArrow=block;fontSize=10;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="av" target="in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="Admin restores" style="html=1;endArrow=block;fontSize=10;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="in" target="av">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="Admin decommissions&lt;br&gt;(end of life)" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="um" target="dc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="Admin decommissions" style="html=1;endArrow=block;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="in" target="dc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="Admin decommissions" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="av" target="dc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="Admin restores" style="html=1;endArrow=block;fontSize=10;dashed=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="dc" target="av">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="700" y="500" /><mxPoint x="110" y="500" /><mxPoint x="110" y="200" /><mxPoint x="250" y="200" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="Inactive and Decommissioned vehicles are &quot;no longer in use&quot;: they are the only valid cannibalization donors (plan task T21)." style="shape=note;whiteSpace=wrap;html=1;align=left;spacingLeft=8;size=14;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="400" y="520" width="440" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- Issue report -->
  <diagram id="st-issue" name="Vehicle Issue Report">
    <mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="State Transition Diagram — Vehicle Issue Report" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p" value="Pending" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="150" y="110" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ur" value="Under Review" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="im" value="In Maintenance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="690" y="110" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rs" value="Resolved" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="690" y="300" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="920" y="315" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="Custodian / Maintenance&lt;br&gt;Personnel reports issue" style="html=1;endArrow=block;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="start" target="p">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="Custodian proposes&lt;br&gt;a ticket" style="html=1;endArrow=block;fontSize=10;verticalAlign=bottom;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="p" target="ur">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="Admin declines ticket" style="html=1;endArrow=block;fontSize=10;verticalAlign=top;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="ur" target="p">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i4" value="Admin approves ticket" style="html=1;endArrow=block;fontSize=10;verticalAlign=bottom;" edge="1" parent="1" source="ur" target="im">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i5" value="Ticket closed" style="html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="im" target="rs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i6" value="Admin dismisses (with reason)" style="html=1;endArrow=block;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p" target="rs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i7" value="" style="html=1;endArrow=block;" edge="1" parent="1" source="rs" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- Schedule -->
  <diagram id="st-schedule" name="Maintenance Schedule">
    <mxGraphModel dx="1000" dy="550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="550" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="State Transition Diagram — Maintenance Schedule" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="1">
